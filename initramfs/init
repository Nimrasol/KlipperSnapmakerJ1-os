#!/bin/sh
# Initramfs of KlipperSnapmakerJ1-os: mount the Linux root file system on
# the userdata partition and start its init
#
# Copyright (C) 2026  Nimrasol
#
# This file may be distributed under the terms of the GNU GPLv3 license.
#
# The stock kernel has no devtmpfs, so /dev is a tmpfs filled by mdev and
# passed on to the root file system.  When the root file system cannot be
# started, a rescue shell is offered over USB (RNDIS network, telnet on
# 192.168.42.1) because the display module has no serial console.

export PATH=/bin:/sbin

ROOT_PARTNAME=userdata
ROOT_OPTIONS=rw,noatime
RESCUE_IP=192.168.42.1

log() {
    echo "initramfs: $*" > /dev/kmsg
    echo "initramfs: $*" >> /run/initramfs.log
}

partition() {
    # Device of the GPT partition with the given name
    for uevent in /sys/class/block/*/uevent; do
        if grep -qx "PARTNAME=$1" "$uevent"; then
            echo "/dev/$(sed -n 's/^DEVNAME=//p' "$uevent")"
            return 0
        fi
    done
    return 1
}

rescue() {
    log "rescue: $*"
    # USB network gadget of the Android kernel (android_usb)
    usb=/sys/class/android_usb/android0
    if [ -d $usb ]; then
        echo 0 > $usb/enable
        echo 18d1 > $usb/idVendor
        echo d002 > $usb/idProduct
        echo rndis > $usb/functions
        echo 1 > $usb/enable
        sleep 2
        ifconfig rndis0 $RESCUE_IP netmask 255.255.255.0 up ||
            ifconfig usb0 $RESCUE_IP netmask 255.255.255.0 up
        telnetd -l /bin/sh
        log "rescue shell: telnet $RESCUE_IP"
    fi
    while true; do
        sleep 3600
    done
}

mkdir -p /proc /sys /dev /run /newroot
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t tmpfs -o mode=0755,size=1M dev /dev
mount -t tmpfs -o mode=0755 run /run
mkdir -p /dev/pts /dev/shm
mknod -m 600 /dev/console c 5 1
mknod -m 666 /dev/null c 1 3
mknod -m 600 /dev/kmsg c 1 11
# mdev as hotplug helper where the kernel offers one (the stock kernel
# does; the device list is rescanned below anyway)
for helper in /proc/sys/kernel/hotplug /sys/kernel/uevent_helper; do
    [ -e $helper ] && echo /sbin/mdev > $helper && break
done
mdev -s
log "started"

# The eMMC appears shortly after the kernel starts init
i=0
while ! device=$(partition $ROOT_PARTNAME); do
    i=$((i + 1))
    [ $i -gt 50 ] && rescue "no partition $ROOT_PARTNAME"
    sleep 0.2
    mdev -s
done
log "root file system on $device"

if ! mount -t ext4 -o $ROOT_OPTIONS "$device" /newroot; then
    rescue "cannot mount $device"
fi
if [ ! -x /newroot/sbin/init ]; then
    umount /newroot
    rescue "$device holds no Linux root file system (not installed?)"
fi
if [ -e /newroot/rescue ]; then
    # Created by hand to get into the rescue shell with the system mounted
    rescue "/rescue exists on the root file system"
fi

cat /run/initramfs.log >> /newroot/var/log/initramfs.log
umount /run
mount --move /dev /newroot/dev
umount /sys
umount /proc
exec switch_root /newroot /sbin/init
